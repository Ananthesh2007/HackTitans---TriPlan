# Copy this file to .env and fill in your own values.
# The .env file must never be committed to Git.
#   cp .env.example .env

# "development" or "production"
APP_ENV=development

# The React frontend addresses allowed to call this API.
# Separate several with commas, no spaces.
FRONTEND_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------
# AI provider
#
# LLM_PROVIDER: "openai", "gemini" or "none" (forces the mock itinerary).
# LLM_API_KEY:  the secret key. NEVER commit a real key. Leave it empty
#               to run the backend on the built-in sample itinerary.
# ------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Leave empty to use the default address for the chosen provider.
LLM_BASE_URL=

# How long to wait for the provider before giving up (seconds).
LLM_TIMEOUT_SECONDS=45

# Maximum tokens for one answer.
LLM_MAX_TOKENS=4000

# Lower values give more predictable JSON.
LLM_TEMPERATURE=0.3

# Set to true to always use the mock itinerary, even with a valid key.
FORCE_MOCK_AI=false
# 19-10-2026 — Secrets safe: .env excluded, .gitignore set
