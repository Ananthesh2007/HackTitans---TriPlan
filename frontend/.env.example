# Copy this file to .env.local and fill in your own values.
# The .env.local file must never be committed to Git.

# The address of the TriPlan backend.
VITE_API_URL=http://localhost:8000

# Set to true to use the built-in sample data instead of calling the backend.
VITE_USE_MOCK=false

# ------------------------------------------------------------------
# Map tiles
#
# These are optional. The app uses dark CARTO tiles, which match the
# design system, when they are not set.
# ------------------------------------------------------------------

# A different tile server. {s}, {z}, {x} and {y} are replaced by Leaflet.
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# The credit line shown on the map. Keep the provider's attribution.
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
